# CampusNow Environment Variables Example
NODE_ENV=production
PORT=5000
# For local dev without a running MongoDB, leave MONGO_URI empty or mongodb://localhost:27017/campusnow
# Server includes automatic in-memory MongoDB fallback in development mode.
# In production, MONGO_URI is required (e.g. MongoDB Atlas: mongodb+srv://<user>:<password>@cluster0.mongodb.net/campusnow?retryWrites=true&w=majority)
MONGO_URI=mongodb+srv://username:password@cluster0.mongodb.net/campusnow?retryWrites=true&w=majority
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_chars
SEED_DEMO=true
CORS_ORIGIN=*
